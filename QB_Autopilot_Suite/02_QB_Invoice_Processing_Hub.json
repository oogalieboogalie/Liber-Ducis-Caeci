{
  "name": "QB Invoice Processing Hub",
  "nodes": [
    {
      "parameters": {
        "path": "invoice-capture",
        "options": {
          "noResponseBody": false
        }
      },
      "id": "webhook-invoice",
      "name": "Invoice Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "unique-id",
              "name": "uniqueId", 
              "value": "{{ $execution.id }}",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "processingTimestamp",
              "value": "{{ $now }}",
              "type": "string"
            },
            {
              "id": "file-path",
              "name": "tempInvoicePath",
              "value": "/tmp/invoice_{{ $execution.id }}_{{ $json.filename || 'upload.pdf' }}",
              "type": "string"
            },
            {
              "id": "client-context",
              "name": "clientId",
              "value": "{{ $json.client_id || 'default' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "table-of-truth",
      "name": "Invoice Table of Truth",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "operation": "writeFile",
        "fileName": "={{ $('Invoice Table of Truth').item.json.tempInvoicePath }}",
        "dataPropertyName": "data"
      },
      "id": "save-file",
      "name": "Save Invoice File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are an expert invoice data extraction AI. Extract ALL invoice information with high accuracy.",
          "temperature": 0.1
        },
        "messages": {
          "values": [
            {
              "content": "Extract complete invoice data from this document. Return ONLY valid JSON with these fields:\n{\n  \"vendor_name\": \"\",\n  \"vendor_address\": \"\",\n  \"invoice_number\": \"\",\n  \"invoice_date\": \"YYYY-MM-DD\",\n  \"due_date\": \"YYYY-MM-DD\", \n  \"total_amount\": 0.00,\n  \"tax_amount\": 0.00,\n  \"subtotal\": 0.00,\n  \"line_items\": [\n    {\n      \"description\": \"\",\n      \"quantity\": 0,\n      \"rate\": 0.00,\n      \"amount\": 0.00\n    }\n  ],\n  \"payment_terms\": \"\",\n  \"confidence_score\": 0.95\n}",
              "role": "user"
            }
          ]
        },
        "model": "gpt-4o-mini",
        "inputType": "binary"
      },
      "id": "ai-extractor",
      "name": "AI Invoice Extractor", 
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [860, 300],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import json\nimport re\nfrom datetime import datetime\n\n# Get AI response\nai_response = _input.first().json['response']['text']\n\n# Extract JSON from AI response\njson_match = re.search(r'\\{.*\\}', ai_response, re.DOTALL)\nif not json_match:\n    raise Exception('No valid JSON found in AI response')\n\ntry:\n    invoice_data = json.loads(json_match.group())\nexcept json.JSONDecodeError as e:\n    raise Exception(f'Failed to parse JSON: {e}')\n\n# Validation rules\nrequired_fields = ['vendor_name', 'invoice_number', 'total_amount']\nfor field in required_fields:\n    if not invoice_data.get(field):\n        raise Exception(f'Missing required field: {field}')\n\n# Data cleaning\nif 'total_amount' in invoice_data:\n    try:\n        invoice_data['total_amount'] = float(str(invoice_data['total_amount']).replace('$', '').replace(',', ''))\n    except:\n        invoice_data['total_amount'] = 0.0\n\n# Add processing metadata\ninvoice_data['processing_id'] = _input.first().json['uniqueId']\ninvoice_data['processed_at'] = datetime.now().isoformat()\ninvoice_data['status'] = 'validated'\n\n# Confidence check\nif invoice_data.get('confidence_score', 0) < 0.8:\n    invoice_data['requires_review'] = True\n    invoice_data['status'] = 'needs_review'\n\nreturn invoice_data"
      },
      "id": "data-validator",
      "name": "Data Validator & Cleaner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "url": "https://quickbooks.api.intuit.com/v3/company/{{ $json.company_id }}/bills",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type", 
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "Bill",
              "value": "{\n  \"VendorRef\": {\n    \"value\": \"1\",\n    \"name\": \"{{ $json.vendor_name }}\"\n  },\n  \"TxnDate\": \"{{ $json.invoice_date }}\",\n  \"DueDate\": \"{{ $json.due_date }}\",\n  \"TotalAmt\": {{ $json.total_amount }},\n  \"DocNumber\": \"{{ $json.invoice_number }}\",\n  \"Line\": [\n    {\n      \"Amount\": {{ $json.subtotal || $json.total_amount }},\n      \"DetailType\": \"AccountBasedExpenseLineDetail\",\n      \"AccountBasedExpenseLineDetail\": {\n        \"AccountRef\": {\n          \"value\": \"7\",\n          \"name\": \"Accounts Payable\"\n        }\n      }\n    }\n  ]\n}"
            }
          ]
        },
        "options": {}
      },
      "id": "qb-create-bill",
      "name": "QuickBooks - Create Bill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300],
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "YOUR_QB_OAUTH_CREDENTIAL_ID",
          "name": "QuickBooks OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": "YOUR_NOTION_INVOICE_LOG_DB_ID",
        "properties": {
          "values": [
            {
              "key": "Invoice Number",
              "textContent": "={{ $('Data Validator & Cleaner').item.json.invoice_number }}"
            },
            {
              "key": "Vendor",
              "textContent": "={{ $('Data Validator & Cleaner').item.json.vendor_name }}"
            },
            {
              "key": "Amount",
              "numberContent": "={{ $('Data Validator & Cleaner').item.json.total_amount }}"
            },
            {
              "key": "Status",
              "textContent": "={{ $json.success ? 'Posted to QB' : 'QB Error' }}"
            },
            {
              "key": "Confidence Score",
              "numberContent": "={{ $('Data Validator & Cleaner').item.json.confidence_score }}"
            },
            {
              "key": "Processing ID",
              "textContent": "={{ $('Data Validator & Cleaner').item.json.processing_id }}"
            }
          ]
        }
      },
      "id": "notion-log",
      "name": "Log to Notion Tracker",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [1520, 300],
      "credentials": {
        "notionApi": {
          "id": "YOUR_NOTION_CREDENTIAL_ID",
          "name": "Notion Integration"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "confidence-check",
              "leftValue": "={{ $('Data Validator & Cleaner').item.json.confidence_score }}",
              "rightValue": 0.8,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combineOperation": "any"
        },
        "options": {}
      },
      "id": "confidence-filter",
      "name": "Needs Human Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1080, 480]
    },
    {
      "parameters": {
        "sendTo": "your-ops-email@company.com",
        "subject": "Invoice Requires Review - {{ $('Data Validator & Cleaner').item.json.vendor_name }}",
        "message": "Invoice processing requires human review:\n\nVendor: {{ $('Data Validator & Cleaner').item.json.vendor_name }}\nAmount: ${{ $('Data Validator & Cleaner').item.json.total_amount }}\nConfidence: {{ $('Data Validator & Cleaner').item.json.confidence_score }}\nProcessing ID: {{ $('Data Validator & Cleaner').item.json.processing_id }}\n\nPlease review and approve in the system.",
        "options": {}
      },
      "id": "review-alert",
      "name": "Send Review Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1300, 600],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Invoice Webhook Trigger": {
      "main": [
        [
          {
            "node": "Invoice Table of Truth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Invoice Table of Truth": {
      "main": [
        [
          {
            "node": "Save Invoice File", 
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Invoice File": {
      "main": [
        [
          {
            "node": "AI Invoice Extractor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Invoice Extractor": {
      "main": [
        [
          {
            "node": "Data Validator & Cleaner",
            "type": "main", 
            "index": 0
          }
        ]
      ]
    },
    "Data Validator & Cleaner": {
      "main": [
        [
          {
            "node": "Needs Human Review?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Human Review?": {
      "main": [
        [
          {
            "node": "Send Review Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "QuickBooks - Create Bill",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "QuickBooks - Create Bill": {
      "main": [
        [
          {
            "node": "Log to Notion Tracker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}